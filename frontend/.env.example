# ─── NIYARA Frontend Storefront — Environment Template ────────────────────────
# Copy this file to .env before running the dev server or building.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# Backend API base URL (must end without a trailing slash)
# Development (localhost backend):
# VITE_API_URL=http://localhost:5000/api
# Production (Render backend):
VITE_API_URL=https://your-niyara-backend.onrender.com/api
